{
	"schemaVersion": 1,
	"id": "goat-expansion",
	"version": "${version}",
	"name": "Goat Reimagined",
	"description": "A comprehensive expansion for mountain goats: tame them with golden carrots, equip custom saddles and pouches, attach protective horn caps, and craft powerful prosthetic horns to turn your mounts into devastating living battering rams!",
	"authors": [
		"presqdy"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/SquidyySYS/Goat-Expansion.git"
	},
	"license": "CC0-1.0",
	"icon": "assets/goat_expansion/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.sqdy.goat_expansion.GoatExpansion"
		],
		"client": [
			"net.sqdy.goat_expansion.GoatExpansionClient"
		],
		"fabric-datagen": [
			"net.sqdy.goat_expansion.GoatExpansionDataGenerator"
		]
	},
	"mixins": [
		"goat-expansion.mixins.json",
		{
			"config": "goat-expansion.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*"
	}
}